generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id               String   @id @default(cuid())
  guestName        String
  guestEmail       String
  guestPhone       String
  preferredContact String
  availability     String
  apartment        String
  room             String
  incident         String
  createdAt        DateTime @default(now())
}
